<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.phoneagent.app"
    android:versionCode="74"
    android:versionName="2.49">

    <!-- INTERNET 仅用于首次下载官方 Termux 环境（约 30MB，一次性）；日常使用仍本地执行 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 刻意不申请其他网络相关能力；HTTP 控制服务仅监听本地 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 应用内更新：下载后调起系统安装 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 11+ 包可见性：挂载冲突检测（官方 Termux）与插件状态检测 -->
    <queries>
        <package android:name="com.termux" />
        <package android:name="com.tailscale.ipn" />
        <package android:name="com.termux.api" />
        <package android:name="com.termux.gui" />
        <package android:name="com.termux.boot" />
        <package android:name="com.termux.widget" />
        <package android:name="com.termux.tasker" />
        <package android:name="com.termux.float" />
        <package android:name="com.termux.styling" />
        <!-- 本地意图路由「打开应用」按名匹配：声明 launcher 查询（无需 QUERY_ALL_PACKAGES） -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".PatchApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light">
        <activity android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name=".CaptureProvider"
            android:authorities="com.phoneagent.app.captureprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
        <provider
            android:name=".UpdateProvider"
            android:authorities="com.phoneagent.app.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
        <service android:name=".AgentAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <service android:name=".AgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="本地 HTTP 控制服务：接收用户自己设备的自动化指令" />
        </service>
    </application>
</manifest>
